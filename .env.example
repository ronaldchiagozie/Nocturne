# Nocturne — environment variables
# Copy this file to `.env` in the project root, then fill in your values.
# Restart the dev server after saving (`npm run dev`).

# ── Firebase (optional — app works without it using local storage) ──
# 1. Go to https://console.firebase.google.com
# 2. Create a project (or open an existing one)
# 3. Build → Firestore Database → Create database (start in test mode for dev)
# 4. Project settings (gear) → Your apps → Web app → copy the firebaseConfig object
# 5. Paste each value below. Do NOT commit `.env` to git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Deploy Firestore rules from the repo root:
#   firebase deploy --only firestore:rules
# (Requires Firebase CLI: npm i -g firebase-tools && firebase login)
#
# After changing firestore.rules locally, deploy before production checkout will accept orders.
