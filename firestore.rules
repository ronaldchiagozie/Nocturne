rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo B2C store — open read/write for prototype. Tighten before production.
    match /store/{document=**} {
      allow read, write: if true;
    }
    match /inventory/{productId} {
      allow read, write: if true;
    }
  }
}
